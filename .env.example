# Copy to .env, fill in values. The script reads this file directly on every
# run, so you do NOT need to `source` it after edits.

# ==== Required: Auth & site ====

# Your Atlassian Cloud site URL (no trailing slash).
JIRA_BASE_URL=https://your-site.atlassian.net

# Atlassian account email of the migration admin.
JIRA_EMAIL=your-email@example.com

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
# Treat like a password. Do NOT commit .env.
JIRA_API_TOKEN=your-api-token-here

# ==== Required per command (can also be passed via --flag) ====

# Source TMP project key (used by extract, stamp-keys).
JIRA_SOURCE_KEY=ABC

# Target CMP project key (used by build, validate).
JIRA_TARGET_KEY=ABCNEW

# ==== Optional ====

# Output directory for all artifacts (logs, JSON, CSV).
JIRA_OUTPUT_DIR=./out

# Text custom field used to preserve the original issue key.
# Default: customfield_25199.
JIRA_KEY_FIELD=customfield_25199

# Target Scrum board ID. Required for sprint creation in `build`.
# Find via: project sidebar -> Board -> URL contains ?rapidView=<id>.
JIRA_TARGET_BOARD_ID=

# Required only if you pass --create-target to `build`.
JIRA_TARGET_LEAD=

# Project template if --create-target. Defaults to Scrum (classic CMP).
# Other options:
#   com.pyxis.greenhopper.jira:gh-simplified-kanban-classic
#   com.pyxis.greenhopper.jira:gh-simplified-basic
JIRA_TARGET_TEMPLATE=com.pyxis.greenhopper.jira:gh-simplified-scrum-classic
