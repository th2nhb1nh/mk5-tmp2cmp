# Copy to .env, fill in values, then `source .env` before running the script.

# Atlassian Cloud site URL (no trailing slash).
export JIRA_BASE_URL="https://yoursite.atlassian.net"

# Atlassian account email of the migration admin.
export JIRA_EMAIL="your-email@example.com"

# API token generated at https://id.atlassian.com/manage-profile/security/api-tokens
# Treat this like a password. Do not commit.
export JIRA_API_TOKEN="paste-token-here"
